{
  "hosts": [
    {
      "id": "robot1",
      "runtimes": [
        {
          "id": "ros2_robot1",
          "kind": "ros2",
          "sources": [
            {
              "id": "odom1",
              "source_kind": "topic",
              "name": "/robot1/odom",
              "interface": "nav_msgs/msg/Odometry"
            }
          ]
        },
        {
          "id": "monitor_robot1",
          "kind": "monitor",
          "subscribe": ["odom1"]
        }
      ]
    },
    {
      "id": "robot2",
      "runtimes": [
        {
          "id": "ros2_robot2",
          "kind": "ros2",
          "sources": [
            {
              "id": "odom2",
              "source_kind": "topic",
              "name": "/robot2/odom",
              "interface": "nav_msgs/msg/Odometry"
            }
          ]
        },
        {
          "id": "monitor_robot2",
          "kind": "monitor",
          "subscribe": ["odom2"]
        }
      ]
    },
    {
      "id": "converter_host",
      "runtimes": [
        {
          "id": "relative_speed",
          "kind": "converter",
          "converter": "dsl_converter",
          "class_path": "custom.relative_speed:RelativeSpeedConverter",
          "input_from": ["odom1", "odom2"],
          "output_to": "relative_speed_record",
          "robot_a": "/robot1",
          "robot_b": "/robot2",
          "property_id": "fleet_relative_speed"
        }
      ]
    },
    {
      "id": "verdict_host",
      "runtimes": [
        {
          "id": "relative_speed_check",
          "kind": "verdict_service",
          "class_path": "custom.threshold_verdict:ThresholdVerdict",
          "input_from": ["relative_speed_record"],
          "output_to": [
            {"kind": "stdout"},
            {"kind": "file", "path": "verdicts_{session_id}.jsonl"}
          ],
          "property_id": "fleet_relative_speed",
          "field": "relative_speed",
          "op": ">",
          "threshold": 0.5
        }
      ]
    }
  ],
  "links": [
    {
      "id": "records_robot1",
      "from_host": "robot1",
      "to_host": "converter_host",
      "from_runtime": "monitor_robot1",
      "to_runtime": "relative_speed",
      "payload": "records",
      "transport": {"kind": "mqtt", "broker": "127.0.0.1", "port": 1883, "qos": 1}
    },
    {
      "id": "records_robot2",
      "from_host": "robot2",
      "to_host": "converter_host",
      "from_runtime": "monitor_robot2",
      "to_runtime": "relative_speed",
      "payload": "records",
      "transport": {"kind": "mqtt", "broker": "127.0.0.1", "port": 1883, "qos": 1}
    },
    {
      "id": "dsl_relative_speed",
      "from_host": "converter_host",
      "to_host": "verdict_host",
      "from_runtime": "relative_speed",
      "to_runtime": "relative_speed_check",
      "payload": "dsl",
      "transport": {"kind": "mqtt", "broker": "127.0.0.1", "port": 1883, "qos": 1}
    }
  ]
}
