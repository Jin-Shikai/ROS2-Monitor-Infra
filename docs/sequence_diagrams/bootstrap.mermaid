sequenceDiagram
    autonumber
    actor User
    participant MN as MonitorNode
    participant Cfg as MonitorConfig
    participant ED1 as Dispatcher[DataRecord]
    participant EXP as Exporter Layer
    participant CV as DataConverter
    participant VS as VerdictService
    participant ED2 as Dispatcher[Any] (DSL)
    participant CM as CollectorManager
    participant DC as DataCollector

    User->>MN: start(yaml_path)
    MN->>Cfg: load(yaml_path)
    Cfg-->>MN: parsed specs

    MN->>ED1: new Dispatcher
    loop for each ExporterSpec
        MN->>ED1: register
        MN->>EXP: build backend
        MN->>ED1: add(exporter)
    end

    loop for each ConverterSpec
        MN->>CV: build DataConverter
        MN->>VS: build VerdictService
        MN->>ED2: new Dispatcher + add VerdictExporter
        MN->>ED1: add ConverterExporter
    end

    MN->>ED1: export
    MN->>CM: new CollectorManager
    MN->>MN: discover active topic types

    loop for each CollectorSpec
        MN->>MN: build TransformerPipeline
        MN->>DC: new DataCollector
        MN->>CM: register
    end

    MN->>CM: start_all()
    CM->>DC: start()
    DC->>DC: attach ROS2 subscription

    MN-->>User: monitor ready
