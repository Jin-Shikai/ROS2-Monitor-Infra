@startuml deployment_diagram
title ROS2-Monitor-Infra — UML Deployment Diagram (final form)

skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 13
skinparam roundCorner 10
skinparam ranksep 35
skinparam nodesep 30
skinparam node {
  BackgroundColor #F7F9FC
  BorderColor #2C3E50
}
skinparam artifact {
  BackgroundColor #FFF6D6
  BorderColor #8B6A0F
}
skinparam database {
  BackgroundColor #FFF6D6
  BorderColor #8B6A0F
}
skinparam cloud {
  BackgroundColor #ECF3FB
  BorderColor #2C3E50
}
skinparam folder {
  BackgroundColor #F7F9FC
  BorderColor #2C3E50
}

left to right direction

legend bottom left
  Stereotypes
  <b><<device>></b>  physical / VM host
  <b><<executionEnvironment>></b>  process / container
  <b><<artifact>></b>  deployable module or file
  <b><<planned>></b>  designed-for, not yet implemented
  ----
  Link labels: <b><<DDS>></b>  <b><<MQTT>></b>  <b><<File I/O>></b>
  <b><<ROS 2 svc>></b>  <b><<ROS 2 param>></b>  <b><<lifecycle>></b>
endlegend

' ========================= EDGE HOST =========================
node "Robot / Edge Host\n<<device>>  network_mode: host" as edge {

  node "ROS 2 Application\n<<executionEnvironment>>" as ros2_app {
    artifact "Pub / Sub\n· Services · Actions\n· Lifecycle · Params" as ros2_iface
  }

  node "Monitor Container\n<<executionEnvironment>>\nROS 2 + rclpy" as mon_ctr {
    artifact "Collectors" as collectors
    artifact "Transformer\nPipeline" as transformers
    artifact "Dispatcher\n[DataRecord]" as disp_data
    artifact "In-proc Verdict\nChain (optional)" as inproc_verdict
  }

  node "Feedback Bridge\n<<executionEnvironment>>\n<<planned>>" as fb_bridge {
    artifact "Intervention\nHandlers" as fb_handlers
  }

  folder "Edge Volume" as edge_vol {
    artifact "<session>.jsonl" as jsonl_edge
    artifact "verdicts.jsonl" as verdicts_edge
  }
}

' ========================= CLOUD =========================
cloud "Cloud" as cloud_box {

  node "Broker Host\n<<device>>" as broker_host {
    node "MQTT Broker\n<<executionEnvironment>>" as broker {
      artifact "monitor/#" as topic_data
      artifact "verdicts/#" as topic_verdicts
      artifact "commands/#\n<<planned>>" as topic_cmd
    }
  }

  node "Verdict Server\n<<device>>" as verdict_host {
    node "VerdictRunner\n<<executionEnvironment>>\nno rclpy" as vrunner {
      artifact "MQTTSource" as mqtt_source
      artifact "DSL Adapters\n(Converters)" as conv_cloud
      artifact "Engines\nLTL · STL · CTL · Custom" as engines
      artifact "Dispatcher\n[Verdict]" as disp_verdict
    }
  }

  node "Data Backend\n<<device>>  <<planned>>" as backend {
    database "Time-series\nDB" as db
    artifact "Dashboards" as dash
    artifact "Offline\nReplay" as replay
    artifact "Archived JSONL" as jsonl_archive
  }
}

' ========================= DEVELOPER =========================
node "Developer Workstation\n<<device>>" as dev {
  artifact "config.yaml" as cfg
  artifact "Plugin modules\n(converters · verdicts · exporters)" as plugins
  artifact "Dockerfile · compose" as docker_art
}

' ========================= EDGE INTERNAL =========================
ros2_iface  -> collectors      : <<DDS>>
collectors  -> transformers
transformers -> disp_data
disp_data   -> jsonl_edge      : <<File I/O>>
disp_data   -> inproc_verdict
inproc_verdict -> verdicts_edge : <<File I/O>>

' ========================= EDGE -> CLOUD =========================
disp_data      ..> topic_data     : <<MQTT>> publish
inproc_verdict ..> topic_verdicts : <<MQTT>> (opt.)

' ========================= CLOUD INTERNAL =========================
topic_data      ..> mqtt_source   : <<MQTT>> subscribe
mqtt_source     -> conv_cloud
conv_cloud      -> engines
engines         -> disp_verdict
disp_verdict    ..> topic_verdicts : <<MQTT>> publish
topic_verdicts  ..> db            : <<MQTT>> <<planned>>
db              -> dash           : <<query>> <<planned>>
jsonl_edge      ..> jsonl_archive : <<sync>> <<planned>>
jsonl_archive   -> replay         : <<File I/O>> <<planned>>
replay          ..> conv_cloud    : <<replay>> <<planned>>\nsame DSL plugins

' ========================= FEEDBACK (planned) =========================
topic_cmd     ..> fb_handlers : <<MQTT>> <<planned>>
fb_handlers   ..> ros2_iface  : <<ROS 2 svc>> · <<param>> · <<lifecycle>>\n<<planned>>

' ========================= DEVELOPER DEPLOY =========================
cfg        ..> mon_ctr  : <<deploy>>
plugins    ..> mon_ctr  : <<deploy>>
plugins    ..> vrunner  : <<deploy>>
docker_art ..> edge     : <<deploy>>

@enduml
