@startuml promotion_slide
title ROS2-Monitor-Infra — Architecture + UML Deployment (Promotion Slide)

skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 12
skinparam roundCorner 10
skinparam ranksep 22
skinparam nodesep 14
skinparam linetype polyline

skinparam package {
  BackgroundColor #DCE5EF
  BorderColor #2C3E50
  FontStyle bold
  FontSize 14
}
skinparam component {
  BackgroundColor #FFF6D6
  BorderColor #8B6A0F
}
skinparam node {
  BackgroundColor #F7F9FC
  BorderColor #2C3E50
}
skinparam artifact {
  BackgroundColor #FFF6D6
  BorderColor #8B6A0F
}
skinparam database {
  BackgroundColor #FFF6D6
  BorderColor #8B6A0F
}
skinparam cloud {
  BackgroundColor #ECF3FB
  BorderColor #2C3E50
}

' =================================================================
'   COLUMN 1 — SPECIFICATION & PLUGINS
' =================================================================
package "Specification & Plugins" as col1 {
  component "Monitor Config\nTopics · Services · Actions\nParams · Lifecycle · QoS" as mon_cfg
  component "Plugin Modules\nConverters · Transformers\nDSL · Verdict Services" as plug_mod
  component "Build & Containerize\nDockerfile · docker-compose" as build_box
  component "Plugin Registry\nbuilt-in | module:Class" as registry

  mon_cfg   -down-> registry
  plug_mod  -down-> registry
  build_box -down-> registry
}

' =================================================================
'   COLUMN 2 — RUNTIME VERIFICATION PIPELINES
' =================================================================
package "Runtime Verification Pipelines" as col2 {

  package "Verdict Service" as verdict_pkg {
    component "LTL" as ltl
    component "STL" as stl
    component "CTL" as ctl
    component "Custom" as cust
  }
  package "DSL Adapters" as dc_pkg {
    component "DC_1" as dc1
    component "DC_2" as dc2
    component "DC_3" as dc3
    component "DC_n" as dcn
  }
  package "Data Processor" as dp_pkg {
    component "Collectors" as dp_mon
    component "Transformers" as dp_filt
    component "Dispatcher" as dp_exp
  }
  package "ROS 2 Application (SUT)" as sut_pkg {
    component "Topics" as t_topics
    component "Services" as t_srv
    component "Actions" as t_act
    component "Lifecycle" as t_life
    component "Params" as t_par
  }

  t_topics -up-> dp_mon
  dp_mon -right-> dp_filt
  dp_filt -right-> dp_exp
  dp_exp -up-> dc1
  dp_exp -up-> dc2
  dp_exp -up-> dc3
  dp_exp -up-> dcn
  dc1 -up-> ltl
  dc2 -up-> stl
  dc3 -up-> ctl
  dcn -up-> cust

  ' Hidden edges to keep SUT row aligned
  t_topics -[hidden]right- t_srv
  t_srv    -[hidden]right- t_act
  t_act    -[hidden]right- t_life
  t_life   -[hidden]right- t_par
}

' =================================================================
'   COLUMN 3 — UML DEPLOYMENT VIEW
' =================================================================
package "Deployment (UML)" as col3 {

  node "Edge Host\n<<device>>" as edge {
    node "Monitor Container\n<<executionEnvironment>>" as mon_ctr {
      artifact "MonitorNode\n(rclpy)" as art_mon
      artifact "Edge JSONL" as art_jsonl_edge
    }
    node "Feedback Bridge\n<<executionEnvironment>>\n<<planned>>" as fb_bridge {
      artifact "Intervention\nHandlers" as fb_handlers
    }
  }

  cloud "Cloud" as cloudbox {
    node "Broker Host\n<<device>>" as broker_host {
      artifact "MQTT Broker" as broker
    }
    node "Verdict Server\n<<device>>" as verdict_host {
      node "VerdictRunner\n<<executionEnvironment>>\nno rclpy" as vrunner {
        artifact "DSL Adapters\n+ Engines" as art_engines
      }
    }
    node "Data Backend\n<<device>> <<planned>>" as backend {
      database "TS DB" as db
      artifact "Dashboards" as dash
      artifact "Offline Replay" as replay
    }
  }

  art_mon  ..> broker  : <<MQTT>>
  broker   ..> vrunner : <<MQTT>>
  vrunner  ..> broker  : verdicts/#
  broker   ..> db      : <<planned>>
  db        -> dash    : <<planned>>
  replay   ..> art_engines : <<replay>> <<planned>>
  broker   ..> fb_handlers : commands/# <<planned>>
  fb_handlers ..> art_mon  : <<svc>>·<<param>>·<<lifecycle>> <<planned>>
}

' =================================================================
'   STRONG HORIZONTAL ALIGNMENT — multi-row hidden anchors
' =================================================================
mon_cfg     -[hidden]right- verdict_pkg
verdict_pkg -[hidden]right- edge
plug_mod    -[hidden]right- dc_pkg
dc_pkg      -[hidden]right- broker_host
build_box   -[hidden]right- dp_pkg
dp_pkg      -[hidden]right- verdict_host
registry    -[hidden]right- sut_pkg
sut_pkg     -[hidden]right- backend

' =================================================================
'   CROSS-COLUMN MAPPING (architecture ↔ deployment)
' =================================================================
registry    ..> col2 : <<configures>>
dp_pkg      ..> art_mon     : <<deploy>>
verdict_pkg ..> art_engines : <<deploy>>
build_box   ..> mon_ctr     : <<deploy>>

legend bottom left
  Stereotypes
  <b><<device>></b> physical / VM host
  <b><<executionEnvironment>></b> process / container
  <b><<artifact>></b> deployable module / file
  <b><<planned>></b> designed, not yet implemented
  ----
  <b><<deploy>></b> dashed: an architectural element
  is hosted on a deployment node
endlegend

@enduml
