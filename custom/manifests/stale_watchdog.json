{
  "id": "stale_watchdog",
  "kind": "converter",
  "name": "Stale Source Watchdog",
  "class_path": "custom.stale_watchdog:StaleWatchdogConverter",
  "params": [
    {
      "key": "timeout_sec",
      "label": "Silence timeout (s)",
      "type": "number",
      "required": true,
      "default": 2.0
    },
    {
      "key": "property_id",
      "label": "Property ID",
      "type": "string",
      "required": false,
      "default": "source_liveness"
    }
  ]
}
