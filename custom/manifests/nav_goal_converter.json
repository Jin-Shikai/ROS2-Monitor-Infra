{
  "id": "nav_goal_converter",
  "kind": "converter",
  "name": "Nav Goal Deadline Converter",
  "class_path": "custom.nav_goal:NavGoalDeadlineConverter",
  "params": [
    {
      "key": "action_name",
      "label": "Action name",
      "type": "string",
      "required": false,
      "default": "/navigate_to_pose"
    },
    {
      "key": "deadline_sec",
      "label": "Deadline (s)",
      "type": "number",
      "required": false,
      "default": 35
    },
    {
      "key": "property_id",
      "label": "Property id",
      "type": "string",
      "required": false,
      "default": "nav_goal_deadline"
    }
  ]
}
